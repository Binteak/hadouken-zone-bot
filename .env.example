# Hadouken Zone - configuración. Copia este archivo como .env y rellena tus valores.
# El .env contiene secretos: no lo compartas ni lo subas a ningún repositorio.

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@hadoukenzone

# true = muestra los mensajes en consola sin publicar | false = publica de verdad
DRY_RUN=true

# --- Fuentes de ofertas ----------------------------------------------------
# chollometro = ofertas de Amazon publicadas en Chollometro (funciona desde GitHub Actions)
# amazon      = scraper directo de Amazon.es (solo desde una conexión doméstica)
# Varias, separadas por comas y en orden de prioridad: chollometro,amazon
OFFER_SOURCES=chollometro

# --- Amazon ------------------------------------------------------------------
# ID de afiliado de Amazon Afiliados (p. ej. hadoukenzone-21). Vacío = enlaces sin afiliado.
AMAZON_PARTNER_TAG=
AMAZON_DOMAIN=www.amazon.es

# --- Calendario ------------------------------------------------------------------
TIMEZONE=Europe/Madrid
# Mensaje de buenos días e inicio de la jornada
GOOD_MORNING_TIME=09:00
# Fin de la jornada (no se publica de noche)
ACTIVE_UNTIL=23:30
# Minutos entre escaneos de Amazon
SCAN_INTERVAL_MINUTES=30
# Segundos entre una oferta y la siguiente
OFFER_DELAY_SECONDS=60
# Máximo de ofertas por escaneo (25 x 60 s caben en 30 min)
MAX_OFFERS_PER_CYCLE=25

# --- Reglas de ofertas -----------------------------------------------------------
MIN_DISCOUNT_PERCENT=15
# Días antes de volver a publicar el mismo producto (antes, solo si baja >= 5 %)
REPUBLISH_AFTER_DAYS=7
# Plataformas (true/false)
INCLUDE_SWITCH_2=true
INCLUDE_PS4=true
# Incluir juegos de Xbox (Series X|S y Xbox One)
INCLUDE_XBOX=true

# --- Scraping (prudencia con Amazon) ------------------------------------------
REQUEST_DELAY_SECONDS=4
SCRAPE_PAGES=2
VERIFY_PRODUCT_PAGE=true
